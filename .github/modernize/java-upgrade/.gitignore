# =========================================================
# DOCLOCK - ROOT GITIGNORE
# =========================================================


# =========================================================
# FRONTEND - NODE / REACT / VITE
# =========================================================

node_modules/
frontend/node_modules/
client/node_modules/

dist/
frontend/dist/
client/dist/

.vite/
frontend/.vite/
client/.vite/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.*
!.env.example

frontend/.env
frontend/.env.*
!frontend/.env.example

client/.env
client/.env.*
!client/.env.example


# =========================================================
# BACKEND - SPRING BOOT / MAVEN
# =========================================================

backend/target/

# Maven wrapper generated/local files
backend/.mvn/wrapper/maven-wrapper.jar

# Spring Boot logs
backend/*.log
backend/logs/
backend/logs/*.log

# Environment files
backend/.env
backend/.env.*
!backend/.env.example


# =========================================================
# SPRING APPLICATION CONFIG
# =========================================================

# Ignore local application configuration because it can
# contain passwords/API keys.
backend/src/main/resources/application.properties

# Ignore profile-specific local configuration
backend/src/main/resources/application-local.properties
backend/src/main/resources/application-dev.properties
backend/src/main/resources/application-prod.properties


# =========================================================
# DOCLOCK UPLOADED DOCUMENTS
# =========================================================

# Uploaded PDFs/files must never go to GitHub
uploads/
backend/uploads/

# Any local storage
storage/
backend/storage/

# Temporary files
tmp/
temp/
backend/tmp/
backend/temp/


