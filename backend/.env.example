# Set these in the Render backend service's Environment section.
DOCLOCK_USERNAME=Ganga
DOCLOCK_PASSWORD=choose-a-strong-password
DOCLOCK_JWT_SECRET=use-a-random-secret-with-at-least-32-characters
DOCLOCK_JWT_EXPIRATION=86400000

# Set the remaining database, Gemini, and upload variables for your deployment.
DB_HOST=
DB_PORT=5432
DB_NAME=doclock_rag
DB_USERNAME=
DB_PASSWORD=
GEMINI_API_KEY=
FILE_UPLOAD_DIR=/tmp/uploads
